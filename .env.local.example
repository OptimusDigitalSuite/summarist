# Firebase — Project settings > General > Your apps > SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stripe — test keys until the subscription flow is real
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Guest login (create this user in Firebase console > Authentication > Users)
NEXT_PUBLIC_GUEST_EMAIL=guest@gmail.com
NEXT_PUBLIC_GUEST_PASSWORD=guest123

# Stripe price ids (from Products in the Stripe dashboard)
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
